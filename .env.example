# Copia este archivo como .env.local y completá los valores reales.
# NUNCA commitees .env.local — está en .gitignore.

# API key de Anthropic (obligatoria)
# Obtené la tuya en: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-REEMPLAZAR

# Modelo de Claude a usar (opcional, default: claude-sonnet-4-6)
ANTHROPIC_MODEL=claude-sonnet-4-6

# URL base de la API del BCRA (opcional)
BCRA_API_BASE_URL=https://api.bcra.gob.ar

# Prefijo del servicio Central de Deudores (opcional)
BCRA_CENTRAL_DEUDORES_PREFIX=centraldedeudores
